<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 用户-角色关联 Mapper XML：演示批量插入、动态条件、批量删除。 -->
<mapper namespace="com.example.system.mapper.SysUserRoleMapper">

    <select id="selectRoleIdsByUserId" resultType="java.lang.Long">
        SELECT role_id FROM sys_user_role
        WHERE user_id = #{userId} AND deleted = 0
    </select>

    <!-- 重置用户角色时物理删除旧关联；关联表 id 为自增，无需逻辑删除。 -->
    <delete id="deleteByUserId">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

    <!--
      foreach 批量 INSERT 示例：一次 SQL 插入多条，减少数据库往返。
      关联表 id 设为自增，此处不显式插入 id，由数据库生成。
    -->
    <insert id="batchInsert">
        INSERT INTO sys_user_role (user_id, role_id, create_by, create_time, deleted)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId}, 'system', NOW(), 0)
        </foreach>
    </insert>

</mapper>
